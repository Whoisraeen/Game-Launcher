# Raeen Launcher — environment configuration
# Copy to `.env` and fill in real values. .env is gitignored; .env.example IS committed.

# --- Cloud / Auth (required for cloud sync, account features, save backup) ---
# Get from your Supabase project → Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Vite/renderer convention (only used if the renderer ever needs them directly)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Discord Rich Presence ---
# Application client ID from https://discord.com/developers/applications
# Leave blank to use the bundled default (which may not work).
DISCORD_CLIENT_ID=

# --- IGDB / metadata fetching (optional) ---
# Twitch app credentials per https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# --- HowLongToBeat (optional) ---
# No key required; left here as a placeholder for future scraper rate limits.

# --- Steam Web API (optional, used by friends/library importers) ---
# https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# --- Platform OAuth (Epic + Microsoft/Xbox), Playnite-style loopback redirect ---
# Main process reads raeen/.env on startup (see electron/main.ts loadLocalEnv).
# Register redirect: http://127.0.0.1:18749/callback (or OAUTH_LOOPBACK_PORT + /callback)
OAUTH_LOOPBACK_PORT=18749

# Azure Portal → App registration → expose Mobile/Desktop → redirect URI above
MICROSOFT_OAUTH_CLIENT_ID=
# Optional; omit for public client + PKCE-only
MICROSOFT_OAUTH_CLIENT_SECRET=
# Optional mirror for tooling that expects VITE_* (main uses MICROSOFT_*)
VITE_MICROSOFT_OAUTH_CLIENT_ID=

# Epic Developer Portal → Product → OAuth / Epic Account Services → redirect URI above
EPIC_OAUTH_CLIENT_ID=
EPIC_OAUTH_CLIENT_SECRET=
VITE_EPIC_OAUTH_CLIENT_ID=
